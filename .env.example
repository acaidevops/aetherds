# AETHER Digital Server environment variables
#
# Copy to `.env.local` for local development and fill in values.
# See docs/engineering/development.md#9-environment-rules: development, staging,
# and production are fully isolated. Never copy production data to lower envs.
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the client bundle.
# Secrets MUST NOT use that prefix (enforced by tests/check-env.example.ts and
# the server-only env module in src/shared/config).

# --- App ---
# Runtime environment label. One of: development | staging | production
APP_ENV=development

# Correlation/trace metadata surfaced in structured logs.
APP_NAME=aetherds
APP_VERSION=0.1.0

# --- Supabase (server-side service identity) ---
# Project URL and service-role key. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54321/postgres

# --- Supabase (anonymous client, safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me-anon

# --- OpenAI (server-side only) ---
# NEVER prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=replace-me-openai

# --- SpotOn (server-side only) ---
# NEVER prefix with NEXT_PUBLIC_.
SPOTON_CLIENT_ID=replace-me-client-id
SPOTON_CLIENT_SECRET=replace-me-client-secret
SPOTON_SANDBOX_BASE_URL=https://sandbox.example.com

# --- Observability ---
# Log level for structured logging. One of: trace | debug | info | warn | error
LOG_LEVEL=info